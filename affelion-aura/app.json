{
  "expo": {
    "name": "Affelion Aura",
    "slug": "affelion-aura",
    "scheme": "affelion-aura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F3F1",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F3F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.affelion.aura",
      "infoPlist": {
        "NSCameraUsageDescription": "Affelion Aura uses the front camera to frame your portrait and the rear camera with the flash to read your pulse from your fingertip. Frames are processed on your device and are not uploaded.",
        "NSMicrophoneUsageDescription": "Affelion Aura listens for a few seconds so it can measure the pitch and variation of your voice. Audio is analyzed on your device and is not stored or uploaded.",
        "NSPhotoLibraryAddUsageDescription": "Affelion Aura saves your Polaroid portrait to your photo library when you ask it to.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.affelion.aura",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4F3F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/fraunces/300Light/Fraunces_300Light.ttf",
            "node_modules/@expo-google-fonts/fraunces/500Medium/Fraunces_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter-tight/300Light/InterTight_300Light.ttf",
            "node_modules/@expo-google-fonts/inter-tight/400Regular/InterTight_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter-tight/500Medium/InterTight_500Medium.ttf",
            "node_modules/@expo-google-fonts/jetbrains-mono/400Regular/JetBrainsMono_400Regular.ttf",
            "node_modules/@expo-google-fonts/jetbrains-mono/500Medium/JetBrainsMono_500Medium.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F3F1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Affelion Aura uses the front camera to frame your portrait and the rear camera with the flash to read your pulse from your fingertip.",
          "microphonePermission": "Affelion Aura listens for a few seconds to measure the pitch and variation of your voice.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Affelion Aura saves your Polaroid portrait to your photo library when you ask it to.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ]
  }
}
